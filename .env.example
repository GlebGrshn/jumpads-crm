TELEGRAM_BOT_TOKEN=
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/crm.sqlite
NODE_ENV=development
# Free self-role selection for local testing. Set false for production.
TEST_ROLE_SELECTION=true
CLIENT_TELEGRAM_BOT_TOKEN=
CLIENT_BOT_USERNAME=
TBANK_MODE=demo
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
APP_PUBLIC_URL=
# Optional: fill BOTH only when your terminal requires a receipt.
TBANK_RECEIPT_TAXATION=
TBANK_RECEIPT_TAX=
# Set true only behind a tunnel or reverse proxy: client IP and public host are taken from X-Forwarded-* headers.
TRUST_PROXY=false
# Stable public entry page (e.g. a redirect to a tunnel whose address changes). Empty disables auto-return.
PUBLIC_ENTRY_URL=
